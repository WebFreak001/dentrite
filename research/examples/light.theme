# Light theme. Read by widgets/button.d at compile time (-J.).
# Colors are #rrggbb, #rrggbbaa or a palette token defined above.

[palette]
gray.100 = #f3f3f5
gray.200 = #e4e5e9
gray.300 = #d0d2d8
gray.500 = #8b8e96
gray.900 = #1d1d20
blue.500 = #2456a8
blue.700 = #1a3f7c
red.500 = #c62f2f
red.700 = #8f1f1f
white = #ffffff
accent = blue.500

[text]
color = gray.900

[button]
fill = gray.200
fillHover = gray.300
fillPressed = gray.500
fillDisabled = gray.100
text = gray.900
textDisabled = gray.500
padX = 8
padY = 4

[button.primary]
text = white
fill = accent
fillHover = blue.700
fillPressed = blue.700

[button.danger]
text = white
fill = red.500
fillHover = red.700
fillPressed = red.700
